{#
/**
 * @file
 * Flat menu template with BEM-style classes and active link highlighting.
 *
 * Available variables:
 * - items: A flat list of menu items.
 *   - attributes: HTML attributes for the <li> element.
 *   - title: The link text.
 *   - url: The link URL.
 *   - in_active_trail: TRUE if the link is in the active trail.
 */
#}
{% if items %}
  <ul{{ attributes.addClass('menu', 'menu--flat') }}>
    {% for item in items %}
      {# Determine BEM classes for each item #}
      {% set item_classes = ['menu__item'] %}
      {% if item.in_active_trail %}
        {% set item_classes = item_classes|merge(['menu__item--active']) %}
      {% endif %}

      <li{{ item.attributes.addClass(item_classes) }}>
        {{ link(item.title, item.url, {'class': ['menu__link']}) }}
      </li>
    {% endfor %}
  </ul>
{% endif %}